# =============================================================================
# SS DENTAL CARE — FRONTEND CLIENT ENVIRONMENT CONFIGURATION
# Vite / React 18 Application
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or BREVO_API_KEY here.
# =============================================================================

# Public Supabase API (Anonymous Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Backend API Endpoint
# In development: http://localhost:5000
# In production on Hostinger: https://api.ssdentalcare.in or https://www.ssdentalcare.in/api
VITE_API_URL=http://localhost:5000

