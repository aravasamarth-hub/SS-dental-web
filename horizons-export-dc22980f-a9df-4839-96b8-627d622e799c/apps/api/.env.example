# =============================================================================
# SS DENTAL CARE — BACKEND API ENVIRONMENT CONFIGURATION
# Production Deployment on Hostinger Node.js Runtime
# IMPORTANT: Never commit actual secret keys or .env files to GitHub.
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=production
PUBLIC_WEBSITE_URL=https://www.ssdentalcare.in
FRONTEND_URL=https://www.ssdentalcare.in

# Supabase Database Configuration (PostgreSQL 15+ via PostgREST)
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
# The Service Role key must ONLY be configured on the backend server, NEVER in the frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Razorpay Online Payment Gateway
# From Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Brevo (formerly Sendinblue) Transactional Email API
# From Brevo Dashboard -> SMTP & API -> API Keys (Generate v3 API Key)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=info@ssdentalcare.in
BREVO_SENDER_NAME="SS Dental Care"
CLINIC_NOTIFICATION_EMAIL=doctor@ssdentalcare.in,aravasamarth@gmail.com

# Scheduled Tasks Security (Cron / Reminders)
# Secret token to protect the POST /api/cron/reminders webhook
CRON_SECRET=generate_a_random_32_character_token_here

# DentaFlow Integration Boundary (Disabled by default until credentials provided)
DENTAFLOW_ENABLED=false
DENTAFLOW_API_URL=https://api.dentaflow.example.com
DENTAFLOW_API_KEY=your_dentaflow_bearer_token
