{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm start --prefix apps/api\"",
		"build": "npm --prefix apps/web run build",
		"start": "concurrently --kill-others --raw \"npm start --prefix apps/web\" \"npm start --prefix apps/api\"",
		"lint": "npm --prefix apps/web run lint"
	},
	"dependencies": {
		"concurrently": "^9.1.2",
		"vite": "^7.3.7"
	},
	"devDependencies": {
		"concurrently": "^9.1.2"
	},
	"workspaces": [
		"apps/*"
	]
}
