<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# If request is not already in dist/apps/web, rewrite to dist/apps/web
	RewriteCond %{REQUEST_URI} !^/dist/apps/web/
	RewriteCond %{DOCUMENT_ROOT}/dist/apps/web%{REQUEST_URI} -f [OR]
	RewriteCond %{DOCUMENT_ROOT}/dist/apps/web%{REQUEST_URI} -d
	RewriteRule ^(.*)$ /dist/apps/web/$1 [L]

	# SPA fallback to dist/apps/web/index.html
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

# ========== GZIP Compression (reduces transferred bytes by 60-80%) ==========
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
	AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
	AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
	AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/font-woff application/font-woff2
	SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|gz|zip|bz2)$ no-gzip dont-vary
	Header append Vary Accept-Encoding
</IfModule>

# ========== Brotli Compression (even better than GZIP) ==========
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
	AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
	AddOutputFilterByType BROTLI_COMPRESS application/json application/xml font/woff font/woff2
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# FORCE HTML pages (index.html) to NEVER be cached by CDN, Nginx, LiteSpeed, or Browser
	Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
	Header set Pragma "no-cache"
	Header set Expires "0"

	# Cache JS/CSS assets for 1 year (Vite adds content hashes so they're cache-safe)
	<FilesMatch "\.(js|css|mjs)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	# Cache static images and fonts for 30 days in browser
	<FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|avif|svg|woff|woff2)$">
		Header set Cache-Control "public, max-age=2592000, immutable"
	</FilesMatch>
</IfModule>
